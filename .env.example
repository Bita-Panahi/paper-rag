# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=papers
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
EMBEDDING_BATCH_SIZE=64
EMBEDDING_PRICE_PER_MILLION_USD=0.02
USD_TO_NOK=10.0

# Step 5 (answers + API)
PDF_DIR=data/pdfs
MANIFEST_PATH=data/papers.csv
MIN_SCORE=0.3
MAX_ANSWER_TOKENS=500
# Leave empty locally. Set a long random value when deployed.
API_KEY=
LOG_LEVEL=INFO
# List prices for the cost estimate. Check them on the OpenAI pricing page.
CHAT_INPUT_PRICE_PER_MILLION_USD=0.15
CHAT_OUTPUT_PRICE_PER_MILLION_USD=0.60
